# Copy this file to "server/.env" and fill in the values.
# NEVER commit the real .env file.

PORT=5000
NODE_ENV=development

# MongoDB connection (local for development, MongoDB Atlas for production).
MONGODB_URI=mongodb://127.0.0.1:27017/umoor_sehhat
# Optional: database name (overrides the one in MONGODB_URI), e.g. US-Jamaat-Wise-Data
MONGODB_DB_NAME=

# How often an open dashboard reloads its data (seconds, 0 = never).
DASHBOARD_REFRESH_SECONDS=120

# Website address(es) allowed to call the API (comma-separated).
CORS_ORIGIN=http://localhost:5173

# ---- Sign-in (Google only) ----
# OAuth 2.0 Client ID (type: Web application) from Google Cloud -> APIs & Services -> Credentials.
# Not a secret. Add your website addresses under 'Authorized JavaScript origins'.
GOOGLE_CLIENT_ID=
# Local testing without Google: shows 'sign in as <Gmail>' on the sign-in page. Ignored in production.
DEV_LOGIN=false

# Two different long random strings (required in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_DAYS=7
REFRESH_TOKEN_DAYS=30

# Audit log entries are kept this many days.
AUDIT_RETENTION_DAYS=365
