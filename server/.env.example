# Copy this file to "server/.env" and fill in the values.
# NEVER commit the real .env file.

PORT=5000
NODE_ENV=development

# MongoDB connection (local for development, MongoDB Atlas for production).
MONGODB_URI=mongodb://127.0.0.1:27017/umoor_sehhat
# Optional: database name (overrides the one in MONGODB_URI), e.g. US-Jamaat-Wise-Data
MONGODB_DB_NAME=

# Google Sheet ID: the long code in the sheet URL between /d/ and /edit
SHEET_ID=your-google-sheet-id

# How the server reads the sheet:
#   public          -> sheet is shared "Anyone with the link"   (no key needed)
#   service-account -> sheet is private and shared with the service account email
SHEET_ACCESS=public

# Only for SHEET_ACCESS=service-account. Use ONE of these:
#   a path to the downloaded JSON key file ...
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/service-account.json
#   ... or the whole JSON key pasted as one line / base64 (handy on hosting platforms)
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# How often the server re-reads the sheet (seconds). The dashboard refreshes on the same interval.
SYNC_INTERVAL_SECONDS=120

# Minimum gap between two "Refresh" button syncs (seconds), protects the Google quota.
MANUAL_REFRESH_COOLDOWN_SECONDS=15

# Website address(es) allowed to call the API (comma-separated).
CORS_ORIGIN=http://localhost:5173

# ---- Sign-in ----
# Two different long random strings (required in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_DAYS=7
REFRESH_TOKEN_DAYS=30
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# First admin user, created on startup if it doesn't exist (remove the password afterwards).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Audit log entries are kept this many days.
AUDIT_RETENTION_DAYS=365
