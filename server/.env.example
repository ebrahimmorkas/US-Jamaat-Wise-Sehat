# Copy this file to "server/.env" and fill in the values.
# NEVER commit the real .env file.

PORT=5000
NODE_ENV=development

# MongoDB connection (local for development, MongoDB Atlas for production).
MONGODB_URI=mongodb://127.0.0.1:27017/umoor_sehhat
# Optional: database name (overrides the one in MONGODB_URI), e.g. US-Jamaat-Wise-Data
MONGODB_DB_NAME=

# ---- Keep-alive (Render free plan) ----
# On Render the server calls its own public /api/health every KEEP_ALIVE_MINUTES (max 14) so the
# free plan never puts it to sleep. Uses RENDER_EXTERNAL_URL (Render sets it) or KEEP_ALIVE_URL.
# Does nothing locally. KEEP_ALIVE_ENABLED=false turns it off (e.g. on a paid plan).
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_MINUTES=10
KEEP_ALIVE_URL=

# ---- Live updates (Socket.IO) ----
# The dashboard updates the moment a JC saves. Set to false to turn live updates off.
REALTIME_ENABLED=true
# Address browsers open the live connection to. Leave empty locally (same address as the website).
# Behind Vercel, set it to the API server itself, e.g. https://your-api.onrender.com
REALTIME_PUBLIC_URL=
# Optional: URL path of the live connection (default /socket.io), ticket lifetime and keep-alive (seconds).
REALTIME_PATH=/socket.io
REALTIME_TICKET_SECONDS=60
REALTIME_PING_SECONDS=25

# Website address(es) allowed to call the API (comma-separated).
CORS_ORIGIN=http://localhost:5173

# ---- Sign-in (Google only) ----
# OAuth 2.0 Client ID (type: Web application) from Google Cloud -> APIs & Services -> Credentials.
# Not a secret. Add your website addresses under 'Authorized JavaScript origins'.
GOOGLE_CLIENT_ID=
# Local testing without Google: shows 'sign in as <Gmail>' on the sign-in page. Ignored in production.
DEV_LOGIN=false

# Two different long random strings (required in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_DAYS=7
REFRESH_TOKEN_DAYS=30

# Audit log entries are kept this many days.
AUDIT_RETENTION_DAYS=365
