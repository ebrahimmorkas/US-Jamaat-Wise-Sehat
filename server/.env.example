# Copy this file to "server/.env" and fill in the values.
# NEVER commit the real .env file.

PORT=5000
NODE_ENV=development

# MongoDB connection (local for development, MongoDB Atlas for production).
MONGODB_URI=mongodb://127.0.0.1:27017/umoor_sehhat
# Optional: database name (overrides the one in MONGODB_URI), e.g. US-Jamaat-Wise-Data
MONGODB_DB_NAME=

# ---- Keep-alive (Render free plan) ----
# On Render the server calls its own public /api/health every KEEP_ALIVE_MINUTES (max 14) so the
# free plan never puts it to sleep. Uses RENDER_EXTERNAL_URL (Render sets it) or KEEP_ALIVE_URL.
# Does nothing locally. KEEP_ALIVE_ENABLED=false turns it off (e.g. on a paid plan).
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_MINUTES=10
KEEP_ALIVE_URL=

# ---- Live updates (Socket.IO) ----
# The dashboard updates the moment a JC saves. Set to false to turn live updates off.
REALTIME_ENABLED=true
# Address browsers open the live connection to. Leave empty locally (same address as the website).
# Behind Vercel, set it to the API server itself, e.g. https://your-api.onrender.com
REALTIME_PUBLIC_URL=
# Optional: URL path of the live connection (default /socket.io), ticket lifetime and keep-alive (seconds).
REALTIME_PATH=/socket.io
REALTIME_TICKET_SECONDS=60
REALTIME_PING_SECONDS=25

# Website address(es) allowed to call the API (comma-separated).
CORS_ORIGIN=http://localhost:5173

# ---- Sign-in (Google only) ----
# OAuth 2.0 Client ID (type: Web application) from Google Cloud -> APIs & Services -> Credentials.
# Not a secret. Add your website addresses under 'Authorized JavaScript origins'.
GOOGLE_CLIENT_ID=
# Local testing without Google: shows 'sign in as <Gmail>' on the sign-in page. Ignored in production.
DEV_LOGIN=false

# Two different long random strings (required in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_DAYS=7
REFRESH_TOKEN_DAYS=30

# Audit log entries are kept this many days.
AUDIT_RETENTION_DAYS=365

# Assistant (chat): a free Groq key from https://console.groq.com/keys . It only reads the wording of
# questions; answers always come from this database. Empty = a simpler built-in reader is used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: models tried when the main one is busy (each has its own free allowance).
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# ---- Stats images: ImageKit (imagekit.io > Developer options > API keys) ----
# Images are uploaded as private files; the portals get links that expire after a few hours.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# ---- Forms (Super Admin builds them, Jamaat Coordinators fill them) ----
# Secret that signs personal form links (empty = derived from JWT_ACCESS_SECRET).
# FORMS_LINK_SECRET=
# Website address used in form links (empty = the first CORS_ORIGIN).
# FORMS_PUBLIC_URL=https://your-site.vercel.app
# IMAGEKIT_FORMS_FOLDER=/umoor-sehhat/forms
# Highest upload sizes in MB (each field can be set lower, never higher).
# FORMS_MAX_IMAGE_MB=10
# FORMS_MAX_VIDEO_MB=50
# FORMS_MAX_FILE_MB=10
# Extensions that may be allowed (comma-separated).
# FORMS_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif,heic
# FORMS_VIDEO_EXTENSIONS=mp4,mov,webm,m4v,3gp
# FORMS_FILE_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,ppt,pptx,txt

# ---- Email ----
# Providers: nodemailer (SMTP, free, the default AND the backup) and sendgrid. The Super Admin switches between
# them in the portal (Emails -> Settings); if SendGrid fails, the email goes out through nodemailer instead.
# Gmail for nodemailer: turn on 2-step verification and create an "app password" (SMTP_PASS).
# EMAIL_PROVIDER=nodemailer   (or sendgrid; "log" = testing: prints instead of sending)
# EMAIL_FROM=Umoor Sehhat <your.account@gmail.com>
# EMAIL_REPLY_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your.account@gmail.com
# SMTP_PASS=
# EMAIL_PER_MINUTE=30
# EMAIL_TIME_ZONE=Asia/Kolkata
# EMAIL_TIME_ZONE_LABEL=India time
# SendGrid (optional):
# SENDGRID_API_KEY=
# SENDGRID_FROM=Umoor Sehhat <verified.sender@yourdomain.com>
# SENDGRID_PER_MINUTE=300
# Attachments in "Send email": total size limit
# EMAIL_MAX_ATTACH_MB=10
